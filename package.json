{
  "name": "portal-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c green,blue \"pnpm --filter @portal/server dev\" \"pnpm --filter @portal/web dev\"",
    "build": "pnpm -r build",
    "start": "concurrently -n server,web -c green,blue \"pnpm --filter @portal/server start\" \"pnpm --filter @portal/web start\"",
    "prod": "env -u NODE_ENV -u TURBOPACK -u NEXT_DEPLOYMENT_ID -u __NEXT_DEV_SERVER pnpm build && pnpm start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:ui": "pnpm --filter @portal/web test:ui",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "packageManager": "pnpm@10.29.3"
}
