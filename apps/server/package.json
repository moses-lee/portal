{
  "name": "@portal/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch src/index.ts",
    "start": "node src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "node --test --test-timeout=15000 --test-reporter=spec tests/*.test.mjs",
    "db:generate": "drizzle-kit generate",
    "postinstall": "node scripts/prepare-pty.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.81.0",
    "@agentclientprotocol/codex-acp": "^1.13.0",
    "@agentclientprotocol/sdk": "^1.5.0",
    "@ai-sdk/anthropic": "^4.0.58",
    "@ai-sdk/openai": "^4.0.71",
    "@fastify/compress": "^9.2.0",
    "@portal/contracts": "workspace:*",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "ai": "^7.0.107",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.7.4",
    "node-pty": "1.1.0",
    "postgres": "^3.4.9",
    "socket.io": "^4.8.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "drizzle-kit": "^0.31.11",
    "socket.io-client": "^4.8.3",
    "typescript": "^5.9.3"
  }
}
